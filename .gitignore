# 忽略 Cline 的缓存和检查点
.cline/
.checkpoints/

# 忽略常见的依赖和临时文件
node_modules/
__pycache__/
.venv/
*.log
*.tmp

# 忽略 VS Code 的本地配置
.vscode/

# 忽略备份工具的测试/运行产物（垃圾目录、临时输出、归档二进制）
dbkp/tmp/
*.dbkp
# 仓库根目录下的临时输出（用 / 锁到根，避免误伤 dbkp/test 等真实源码）
/test/
/test_out/
/tmp/

# 调试草稿区：界面验收截图、一次性探针脚本与提交消息临时文件
# 只做过程留证，不入库；确实要提交其中的脚本时用 git add -f _probe/<file>
_probe/

# web_full_test.ps1 每次运行自建自清的数据根，残留产物不入库
dbkp/_webtest_demo/

# GoogleTest 全量链接产物约 104 MB，超过 GitHub 单文件上限，需要时
# mingw32-make test-gtest 重建，不入库
dbkp/bin/bk_gtest.exe

# ---- 2026-11-15 加固轮：攻击/回归临时产物，绝不入库 ----
# _attack2/ 单目录约 391 MB（3000 个测试文件 + 3 个 64MB 归档）
dbkp/_attack/
dbkp/_attack2/
dbkp/_attack5/
dbkp/_attack2_result.txt
dbkp/_attack5_result.txt
dbkp/_attack_web_result.txt
dbkp/_attack_cli_result.txt
dbkp/_b6_tamper/
dbkp/_globtest/
dbkp/_vssample/
dbkp/_jct/
dbkp/_ut_*.log
dbkp/_stab_rerun_view.txt
dbkp/tchk_*.txt
# 编译中间产物（注意：obj*/ 下已有历史跟踪的 .o，本规则只挡新增）
dbkp/objg/
dbkp/objut/
dbkp/objcov/
dbkp/obj/
# 本机 IDE 与临时构建的二进制（正式交付的 bk/bkd/bk_test.exe 仍需提交）
dbkp/.vs/
dbkp/bin/bk_new.exe
dbkp/bin/bk_test_current.exe
dbkp/bin/bk_test_after_maxdepth.exe

# 攻击诱饵、探针输出、冒烟临时文本（过程留证，不入库）
.vs/
/_*.txt
/_b*.ps1
/_txt/
dbkp/BAIT*.txt
dbkp/p?_*.txt
dbkp/smoke*.txt
dbkp/runwin.c
dbkp/runwin.exe
dbkp/_m6_tamper/
dbkp/_b*_instruction.md
dbkp/dbkp_web_test_tutorial.ps1

# 注意：dbkp/doc/ 与 dbkp/script/ 下的正式证据与复现脚本**不忽略**，
# 它们是 doc/03、doc/05 与独立测试报告引用的依据，必须随源码一起提交。