# 忽略 Cline 的缓存和检查点
.cline/
.checkpoints/

# 忽略常见的依赖和临时文件
node_modules/
__pycache__/
.venv/
*.log
*.tmp

# 忽略 VS Code 的本地配置
.vscode/

# 忽略备份工具的测试/运行产物（垃圾目录、临时输出、归档二进制）
System.Collections.Hashtable/
dbkp/tmp/
*.dbkp
# 仓库根目录下的临时输出（用 / 锁到根，避免误伤 dbkp/test 等真实源码）
/test/
/test_out/
/tmp/