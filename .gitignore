# 忽略 Cline 的缓存和检查点
.cline/
.checkpoints/

# 忽略常见的依赖和临时文件
node_modules/
__pycache__/
.venv/
*.log
*.tmp

# 忽略 VS Code 的本地配置
.vscode/

# 忽略备份工具的测试/运行产物（垃圾目录、临时输出、归档二进制）
dbkp/tmp/
*.dbkp
# 仓库根目录下的临时输出（用 / 锁到根，避免误伤 dbkp/test 等真实源码）
/test/
/test_out/
/tmp/

# 调试草稿区：界面验收截图、一次性探针脚本与提交消息临时文件
# 只做过程留证，不入库；确实要提交其中的脚本时用 git add -f _probe/<file>
_probe/

# web_full_test.ps1 每次运行自建自清的数据根，残留产物不入库
dbkp/_webtest_demo/

# GoogleTest 全量链接产物约 104 MB，超过 GitHub 单文件上限，需要时
# mingw32-make test-gtest 重建，不入库
dbkp/bin/bk_gtest.exe